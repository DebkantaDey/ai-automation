# ==========================================
# AI Business Automation SaaS Environment Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/ai_automation_saas

# Redis Cache & BullMQ Queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Secrets (Min 32 characters)
JWT_SECRET=your-secure-jwt-access-secret-32-chars-long
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Encryption Key for Integration Credentials (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Gateway API Keys
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# Payment Gateways (Stripe & Razorpay)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Storage (AWS S3 or Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_BUCKET=saas-documents-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email Dispatcher
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=...
EMAIL_FROM="AI Business Automation <noreply@saasplatform.com>"
