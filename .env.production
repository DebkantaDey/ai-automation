NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=https://app.saasplatform.com
CORS_ORIGINS=https://app.saasplatform.com
MONGODB_URI=mongodb+srv://production-user:production-pass@cluster0.mongodb.net/ai_automation_saas?retryWrites=true&w=majority
REDIS_HOST=redis-cluster-prod.internal
REDIS_PORT=6379
JWT_SECRET=production-access-token-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=production-refresh-token-secret-minimum-32-chars-long
AI_DEFAULT_PROVIDER=openai
