# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Database (MongoDB)
# Local: mongodb://localhost:27017/ai_automation_saas
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_automation_saas?retryWrites=true&w=majority
# ==========================================
MONGODB_URI=mongodb://localhost:27017/ai_automation_saas
MONGODB_MAX_POOL_SIZE=20

# ==========================================
# Redis (BullMQ Queues & Caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=auto_saas:
REDIS_TLS=false

# ==========================================
# Authentication & JWT
# ==========================================
JWT_SECRET=super-secret-jwt-access-key-change-in-production-12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-67890
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

# ==========================================
# SaaS Billing & Subscriptions
# ==========================================
BILLING_DEFAULT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Trial & Grace Period Settings
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=7
TRIAL_PLAN=starter
GRACE_PERIOD_DAYS=3

# ==========================================
# AI Integrations
# ==========================================
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# File Storage
# ==========================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
